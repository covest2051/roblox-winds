				"EnvironmentSpecularScale": 0.6
			}
		},
		"Workspace": {
			"$properties": {
				"Gravity": 196.2,
				"StreamingEnabled": false
			}
		},
		"SoundService": {
			"$properties": {
				"RespectFilteringEnabled": true
			}
		},
		"Players": {
			"$properties": {
				"CharacterAutoLoads": false
			}
		}
	}

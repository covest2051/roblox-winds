{
	"name": "Winds",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			},
			"Remotes": {
				"$className": "Folder",
				"ClientAction": {
					"$className": "RemoteEvent"
				},
				"ServerEvent": {
					"$className": "RemoteEvent"
				}
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},
		"StarterPlayer": {
			"$properties": {
				"CameraMaxZoomDistance": 160,
				"CameraMinZoomDistance": 22,
				"CharacterWalkSpeed": 16,
				"CharacterJumpHeight": 0
			},
			"StarterPlayerScripts": {
